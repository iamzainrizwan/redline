#!/usr/bin/env bash
# Test the rice bar extension in a throwaway headless GNOME Shell, without
# touching the live session or logging out:
#
#   rice-bar-test            → prints the output dir: probe.txt, cycle.txt,
#                              panel.png, screen.png, osd.png (US→UK
#                              layout popup), osd-file.png (rice-osd),
#                              osd-level.png (volume-style), shell.log
#   RICE_BAR_TEST_HOVER=dateMenu rice-bar-test
#                            → same, with that panel item (a statusArea
#                              role) drawn hovered in the screenshots
#   RICE_BAR_TEST_SHOW=overview|apps|lock rice-bar-test
#                            → same, with the overview, app grid or lock
#                              screen up in screen.png
#   RICE_BAR_TEST_OPEN=quickSettings rice-bar-test
#                            → same, with that item's menu open
#   RICE_BAR_TEST_TRACK='a long title' rice-bar-test
#                            → the fake player's track title (with
#                              HOVER=rice-nowplaying: the track card)
#   RICE_BAR_TEST_UPOWER=1 rice-bar-test
#                            → a fake UPower on the test bus: on battery
#                              (64%, 3:12 left), headphones at 80% and a
#                              mouse at 15%; also forces the cpu/mem
#                              alerts on (threshold 0) and the live /
#                              mic off tags. The headphones are Nothing
#                              buds, so with HOVER=rice-devices the buds
#                              card shows (a fake bin/buds, in nc mid)
#   RICE_BAR_TEST_CALENDAR=1 rice-bar-test
#                            → the tag on its calendar source, fed by a fake
#                              GNOME calendar server: an event that ended,
#                              one on now, one in 3 h and an all-day one
#                              (HOVER=rice-tag: the day card)
#
# The test shell gets its own session bus and its own XDG config/data/cache
# dirs, so its dconf writes land in a scratch database. That isolation only
# holds if the XDG vars are set BEFORE dbus-run-session starts (dconf-service
# inherits the bus daemon's environment, not ours) — set them later and the
# test's gsettings calls overwrite the real settings. Two guards check this.
#
# It loads the user theme + rice bar + a probe extension that, after the
# bar settles, records the panel layout, screenshots it, then disables and
# re-enables the bar (what the lock screen does) and records that too. A
# fake MPRIS player and a GTK3 window give the now-playing and title
# segments something to show.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
EXT="$REPO/rice-bar@zain"
T="$(mktemp -d "${TMPDIR:-/tmp}/rice-bar-test.XXXXXX")"
mkdir -p "$T"/{config,cache,out,data/gnome-shell/extensions/rice-probe@zain}
ln -s "$EXT" "$T/data/gnome-shell/extensions/rice-bar@zain"

cat > "$T/data/gnome-shell/extensions/rice-probe@zain/metadata.json" <<'EOF'
{"uuid": "rice-probe@zain", "name": "rice bar test probe", "description": "test only", "shell-version": ["46"]}
EOF
cat > "$T/data/gnome-shell/extensions/rice-probe@zain/extension.js" <<EOF
import Gio from 'gi://Gio';
import GLib from 'gi://GLib';
import Shell from 'gi://Shell';
import * as Main from 'resource:///org/gnome/shell/ui/main.js';
import {Extension} from 'resource:///org/gnome/shell/extensions/extension.js';

Gio._promisify(Shell.Screenshot.prototype, 'screenshot_area');
const OUT = '$T/out';
const pause = ms => new Promise(r => GLib.timeout_add(0, ms, () => { r(); return GLib.SOURCE_REMOVE; }));

function describe(box) {
    return box.get_children().map(c => {
        const role = Object.keys(Main.panel.statusArea).find(r => Main.panel.statusArea[r]?.container === c);
        return \`\${role ?? c.constructor.name}\${c.visible ? '' : '(hidden)'}\`;
    }).join(' | ');
}

function layout() {
    const qs = Main.panel.statusArea.quickSettings;
    return [
        'left:   ' + describe(Main.panel._leftBox),
        'center: ' + describe(Main.panel._centerBox),
        'right:  ' + describe(Main.panel._rightBox),
        'battery icon visible: ' + qs._system?._indicator.visible,
        'clock box: ' + Main.panel.statusArea.dateMenu._clockDisplay.get_parent()
            .get_children().map(c => c.constructor.name).join(' | '),
    ];
}

export default class extends Extension {
    enable() {
        this._run().catch(e => {
            logError(e, 'rice-probe');
            GLib.file_set_contents(OUT + '/error.txt', String(e) + '\n' + e.stack);
            GLib.file_set_contents(OUT + '/done', 'error');
        });
    }

    disable() {}

    async _run() {
        // a notification, so the clock's notification dot (and the centring
        // pad GNOME pairs with it) would be showing
        Main.notify('rice-bar-test', 'notification dot check');
        await pause(14000);
        // a headless shell doesn't always focus a new window; make sure the
        // title segment has something to show
        const overviewAtStart = Main.overview.visible;
        Main.overview.hide();
        global.get_window_actors().map(a => a.meta_window)
            .find(w => !w.skip_taskbar)?.activate(global.get_current_time());
        await pause(2000);
        const bar = Main.panel.statusArea;
        const clockBox = bar.dateMenu._clockDisplay.get_parent();
        GLib.file_set_contents(OUT + '/probe.txt', [
            ...layout(),
            'focus: ' + global.display.focus_window?.get_title() + \` (overview was \${overviewAtStart ? 'open' : 'closed'}, now \${Main.overview.visible ? 'open' : 'closed'})\`,
            'title label: ' + bar['rice-title']?._label.text,
            'workspaces: ' + bar['rice-workspaces']?._box.get_children().map(b => b.get_style_class_name()).join(' / '),
            // x+width of each right-side item and the clock's insides, for
            // spotting dead gaps between segments
            'right geometry: ' + Main.panel._rightBox.get_children().filter(c => c.visible)
                .map(c => \`\${Object.keys(bar).find(r => bar[r]?.container === c) ?? c.constructor.name}@\${Math.round(c.get_transformed_position()[0])}+\${Math.round(c.width)}\`).join(' '),
            'clock geometry: ' + [bar.dateMenu, ...clockBox.get_children(), bar.quickSettings, ...bar.quickSettings._indicators.get_children()]
                .filter(c => c.visible).map(c => \`\${c.constructor.name}@\${Math.round(c.get_transformed_position()[0])}+\${Math.round(c.width)}\`).join(' '),
            'clock box: ' + clockBox.get_children().map(c => \`\${c.constructor.name}\${c.visible ? '' : '(hidden)'}\`).join(' | '),
        ].join('\n') + '\n');

        const open = GLib.getenv('RICE_BAR_TEST_OPEN');
        if (open)
            bar[open]?.menu.open(false);
        const show = GLib.getenv('RICE_BAR_TEST_SHOW');
        if (show === 'overview')
            Main.overview.show();
        else if (show === 'apps')
            Main.overview.showApps();
        else if (show === 'lock')
            Main.screenShield.lock(false);
        if (show)
            await pause(2500);
        if (GLib.getenv('RICE_BAR_TEST_UPOWER')) {
            bar['rice-live']?.setSharing(true);
            bar['rice-micoff'] && (bar['rice-micoff'].text = 'mic off');
        }
        const hover = GLib.getenv('RICE_BAR_TEST_HOVER');
        if (hover) {
            bar[hover]?.add_style_pseudo_class('hover');
            bar[hover]?.set_hover(true); // what tooltips listen for
        }
        await pause(500);
        const w = global.stage.width;
        for (const [name, h] of [['panel', Main.panel.height + 8], ['screen', global.stage.height]]) {
            const stream = Gio.File.new_for_path(\`\${OUT}/\${name}.png\`)
                .replace(null, false, Gio.FileCreateFlags.NONE, null);
            await new Shell.Screenshot().screenshot_area(0, 0, w, h, stream);
            stream.close(null);
        }

        // switching to the spare empty workspace should reveal the switcher
        const wsSegment = bar['rice-workspaces'];
        const wsLine = () => \`workspaces visible=\${wsSegment.visible}: \` +
            wsSegment._box.get_children().map(b => \`\${b.label}[\${b.get_style_class_name()}]\`).join(' ');
        const wsBefore = wsLine();
        global.workspace_manager.get_workspace_by_index(global.workspace_manager.n_workspaces - 1)
            .activate(global.get_current_time());
        await pause(1500);
        const wsAfter = wsLine();
        global.workspace_manager.get_workspace_by_index(0).activate(global.get_current_time());
        await pause(1500);
        GLib.file_set_contents(OUT + '/workspaces.txt',
            ['on workspace 1:    ' + wsBefore, 'on the empty last: ' + wsAfter, 'back on 1:         ' + wsLine()].join('\\n') + '\\n');

        const em = Main.extensionManager;
        await em.disableExtension('rice-bar@zain');
        await pause(2000);
        const disabled = layout();
        await em.enableExtension('rice-bar@zain');
        await pause(2000);
        GLib.file_set_contents(OUT + '/cycle.txt', [
            '--- after disable', ...disabled,
            '--- after re-enable', ...layout(),
            'state: ' + em.lookup('rice-bar@zain')?.state + ' (1 = enabled)',
        ].join('\n') + '\n');
        // control: GNOME's OSD shown directly, no layout change involved
        Main.osdWindowManager.show(-1, Gio.ThemedIcon.new('audio-volume-high-symbolic'), 'control');
        await pause(400);
        const ctl = Main.osdWindowManager._osdWindows[0];
        GLib.file_set_contents(OUT + '/osd-control.txt', \`control visible=\${ctl.visible} opacity=\${ctl.opacity}\n\`);
        await pause(2500);
        // a layout change should pop the OSD (layoutosd.js)
        const sources = new Gio.Settings({schema_id: 'org.gnome.desktop.input-sources'});
        sources.set_value('sources', new GLib.Variant('a(ss)', [['xkb', 'us']]));
        // past the first OSD's 1.5 s hide + fade, which would otherwise hide
        // this one as it finishes
        await pause(3000);
        sources.set_value('sources', new GLib.Variant('a(ss)', [['xkb', 'gb']]));
        await pause(400);
        const osd = Main.osdWindowManager._osdWindows[0];
        GLib.file_set_contents(OUT + '/osd.txt', \`osd visible=\${osd?.visible} label=\${osd?._label.text} timer=\${osd?._hideTimeoutId} opacity=\${osd?.opacity} gicon=\${osd?._icon.gicon} windows=\${Main.osdWindowManager._osdWindows.length} monitors=\${Main.layoutManager.monitors.length}\n\`);
        const osdStream = Gio.File.new_for_path(OUT + '/osd.png')
            .replace(null, false, Gio.FileCreateFlags.NONE, null);
        await new Shell.Screenshot().screenshot_area(0, 0, global.stage.width, global.stage.height, osdStream);
        osdStream.close(null);
        // bin/rice-osd -> riceosd.js: a script-triggered OSD (test's own file)
        await pause(3000);
        GLib.spawn_command_line_async(\`$REPO/bin/rice-osd video-display-symbolic '60 Hz'\`);
        await pause(700);
        const fosd = Main.osdWindowManager._osdWindows[0];
        GLib.file_set_contents(OUT + '/osd-file.txt', \`rice-osd visible=\${fosd.visible} label=\${fosd._label.text}\n\`);
        const fileStream = Gio.File.new_for_path(OUT + '/osd-file.png')
            .replace(null, false, Gio.FileCreateFlags.NONE, null);
        await new Shell.Screenshot().screenshot_area(0, 0, global.stage.width, global.stage.height, fileStream);
        fileStream.close(null);
        // a volume-style OSD with a level bar, for the theme's bar colours
        await pause(3000);
        Main.osdWindowManager.show(-1, Gio.ThemedIcon.new('audio-volume-medium-symbolic'), 'Speakers', 0.6, 1);
        await pause(600);
        const levelStream = Gio.File.new_for_path(OUT + '/osd-level.png')
            .replace(null, false, Gio.FileCreateFlags.NONE, null);
        await new Shell.Screenshot().screenshot_area(0, 0, global.stage.width, global.stage.height, levelStream);
        levelStream.close(null);
        GLib.file_set_contents(OUT + '/done', 'ok');
    }
}
EOF

cat > "$T/fake-player.py" <<'EOF'
import os
from gi.repository import Gio, GLib
XML = '''<node><interface name="org.mpris.MediaPlayer2.Player">
<property name="PlaybackStatus" type="s" access="read"/>
<property name="Metadata" type="a{sv}" access="read"/>
<property name="Position" type="x" access="read"/>
<method name="PlayPause"/><method name="Next"/><method name="Previous"/>
</interface></node>'''
TITLE = os.environ.get('RICE_BAR_TEST_TRACK') or 'Windowlicker'
def get_prop(conn, sender, path, iface, prop):
    if prop == 'PlaybackStatus':
        return GLib.Variant('s', 'Playing')
    if prop == 'Position':
        return GLib.Variant('x', 90_000_000)  # 1:30 of 6:07
    return GLib.Variant('a{sv}', {'xesam:title': GLib.Variant('s', TITLE),
                                  'xesam:artist': GLib.Variant('as', ['Aphex Twin']),
                                  'xesam:album': GLib.Variant('s', 'Windowlicker EP'),
                                  'mpris:length': GLib.Variant('x', 367_000_000),
                                  'mpris:artUrl': GLib.Variant('s', 'file:///usr/share/icons/hicolor/256x256/apps/firefox.png')})
def on_bus(conn, name):
    conn.register_object('/org/mpris/MediaPlayer2', Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0],
                         lambda *a: a[-1].return_value(None), get_prop, None)
Gio.bus_own_name(Gio.BusType.SESSION, 'org.mpris.MediaPlayer2.fakeplayer', 0, on_bus, None, None)
GLib.MainLoop().run()
EOF

cat > "$T/fake-upower.py" <<'EOF'
from gi.repository import Gio, GLib
BASE = '/org/freedesktop/UPower/devices/'
XML = '''<node>
<interface name="org.freedesktop.UPower">
<method name="EnumerateDevices"><arg type="ao" direction="out"/></method>
<signal name="DeviceAdded"><arg type="o"/></signal>
<signal name="DeviceRemoved"><arg type="o"/></signal>
</interface>
<interface name="org.freedesktop.UPower.Device">
<property name="Type" type="u" access="read"/>
<property name="PowerSupply" type="b" access="read"/>
<property name="IsPresent" type="b" access="read"/>
<property name="Percentage" type="d" access="read"/>
<property name="State" type="u" access="read"/>
<property name="TimeToEmpty" type="x" access="read"/>
<property name="TimeToFull" type="x" access="read"/>
<property name="Model" type="s" access="read"/>
</interface></node>'''
NODE = Gio.DBusNodeInfo.new_for_xml(XML)
# Type 2 battery, 19 headphones, 5 mouse; State 2 discharging
DEVICES = {
    'DisplayDevice': dict(Type=('u', 2), PowerSupply=('b', True), IsPresent=('b', True),
                          Percentage=('d', 64.0), State=('u', 2), TimeToEmpty=('x', 11520),
                          TimeToFull=('x', 0), Model=('s', '')),
    'headset_dev_00': dict(Type=('u', 19), PowerSupply=('b', False), IsPresent=('b', True),
                           Percentage=('d', 80.0), State=('u', 2), TimeToEmpty=('x', 0),
                           TimeToFull=('x', 0), Model=('s', 'Nothing Ear (a)')),
    'mouse_dev_01': dict(Type=('u', 5), PowerSupply=('b', False), IsPresent=('b', True),
                         Percentage=('d', 15.0), State=('u', 2), TimeToEmpty=('x', 0),
                         TimeToFull=('x', 0), Model=('s', 'M602')),
}
def call(conn, sender, path, iface, method, params, inv):
    inv.return_value(GLib.Variant('(ao)', ([BASE + n for n in DEVICES if n != 'DisplayDevice'],)))
def get_prop(conn, sender, path, iface, prop):
    t, v = DEVICES[path.rsplit('/', 1)[1]][prop]
    return GLib.Variant(t, v)
def on_bus(conn, name):
    conn.register_object('/org/freedesktop/UPower', NODE.interfaces[0], call, None, None)
    for n in DEVICES:
        conn.register_object(BASE + n, NODE.interfaces[1], None, get_prop, None)
Gio.bus_own_name(Gio.BusType.SESSION, 'org.freedesktop.UPower', 0, on_bus, None, None)
GLib.MainLoop().run()
EOF

# GNOME's calendar server stand-in: answers SetTimeRange with today's events
cat > "$T/fake-calendar.py" <<'EOF'
import time
from gi.repository import Gio, GLib
XML = '''<node><interface name="org.gnome.Shell.CalendarServer">
<method name="SetTimeRange"><arg type="x" direction="in"/><arg type="x" direction="in"/><arg type="b" direction="in"/></method>
<signal name="EventsAddedOrUpdated"><arg type="a(ssxxa{sv})"/></signal>
<signal name="EventsRemoved"><arg type="as"/></signal>
<signal name="ClientDisappeared"><arg type="s"/></signal>
<property name="HasCalendars" type="b" access="read"/>
</interface></node>'''
IFACE = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]
PATH = '/org/gnome/Shell/CalendarServer'
now = int(time.time()) // 300 * 300
lt = time.localtime()
midnight = int(time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1)))
EVENTS = [  # an id ending in a newline isn't recurring
    ('test\nallday\n', 'bin day', midnight, midnight + 86400, {}),
    ('test\npast\n', 'standup', now - 7200, now - 5400, {}),
    ('test\nnow\n', 'design review', now - 600, now + 3000, {}),
    ('test\nlater\n', 'gym', now + 10800, now + 14400, {}),
]
def call(conn, sender, path, iface, method, params, inv):
    inv.return_value(None)
    conn.emit_signal(None, PATH, IFACE.name, 'EventsAddedOrUpdated',
                     GLib.Variant('(a(ssxxa{sv}))', (EVENTS,)))
def get_prop(conn, sender, path, iface, prop):
    return GLib.Variant('b', True)
def on_bus(conn, name):
    conn.register_object(PATH, IFACE, call, get_prop, None)
Gio.bus_own_name(Gio.BusType.SESSION, 'org.gnome.Shell.CalendarServer', 0, on_bus, None, None)
GLib.MainLoop().run()
EOF

# bin/buds stand-in for the buds card: --json [mode], starting in nc mid
cat > "$T/fake-buds" <<'EOF'
#!/usr/bin/env bash
mode=mid codec=ldac dual=true
for a; do case $a in --json|dual) ;; ldac|aac) codec=$a ;; on) dual=true ;; off) dual=false ;; *) mode=$a ;; esac; done
printf '{"name": "Nothing Ear (a)", "mac": "00:00:00:00:00:00", "mode": "%s", "codec": "%s", "dual": %s, "battery": [{"part": "L", "percent": 80, "charging": false}, {"part": "R", "percent": 75, "charging": false}, {"part": "case", "percent": 40, "charging": true}]}\n' "$mode" "$codec" "$dual"
EOF
chmod +x "$T/fake-buds"

cat > "$T/window.py" <<'EOF'
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk
w = Gtk.Window(title='~/rice — nvim')
w.set_default_size(800, 500)
w.show_all()
Gtk.main()
EOF

cat > "$T/inner.sh" <<EOF
#!/usr/bin/env bash
# guard 1: the bus daemon (our parent) must carry the scratch config dir
tr '\0' '\n' < /proc/\$PPID/environ | grep -qx 'XDG_CONFIG_HOME=$T/config' ||
  { echo "ABORT: bus not isolated" >&2; exit 1; }
# guard 2: a dconf write must land in the scratch database
dconf write /org/rice/isolation-probe true
[[ -f $T/config/dconf/user ]] ||
  { dconf reset /org/rice/isolation-probe; echo "ABORT: dconf not isolated" >&2; exit 1; }

gsettings set org.gnome.shell enabled-extensions \
  "['user-theme@gnome-shell-extensions.gcampax.github.com', 'rice-bar@zain', 'rice-probe@zain']"
gsettings set org.gnome.shell disable-user-extensions false
gsettings set org.gnome.desktop.interface color-scheme prefer-dark
gsettings set org.gnome.desktop.interface clock-show-weekday true
gsettings set org.gnome.desktop.interface clock-show-date true
gsettings set org.gnome.desktop.interface show-battery-percentage false
dconf write /org/gnome/shell/extensions/user-theme/name "'rice'"

export RICE_OSD_FILE=$T/rice-osd  # keep rice-osd off the real session's file
python3 -I $T/fake-player.py &
if [[ -n "${RICE_BAR_TEST_UPOWER:-}" ]]; then
  python3 -I $T/fake-upower.py &
  export RICE_BAR_UPOWER_BUS=session RICE_BAR_HOT_PERCENT=0 RICE_BAR_BUDS=${RICE_BAR_BUDS:-$T/fake-buds}
fi
if [[ -n "${RICE_BAR_TEST_CALENDAR:-}" ]]; then
  python3 -I $T/fake-calendar.py &
  export RICE_BAR_TAG=calendar
  sleep 1  # own the name before the shell asks for it
fi
gnome-shell --headless --wayland --virtual-monitor 1920x1080 --mode=ubuntu > $T/out/shell.log 2>&1 &
shell=\$!

# open the window on the test shell's socket only — never the real one
for _ in \$(seq 40); do
  wl=\$(grep -oP "Using Wayland display name '\\K[^']+" $T/out/shell.log | head -1 || true)
  [[ -n \$wl ]] && break
  sleep 0.5
done
if [[ -n \${wl:-} && \$wl != "$WAYLAND_DISPLAY" ]]; then
  (sleep 3; WAYLAND_DISPLAY=\$wl GDK_BACKEND=wayland NO_AT_BRIDGE=1 python3 -I $T/window.py) >/dev/null 2>&1 &
fi

for _ in \$(seq 60); do [[ -f $T/out/done ]] && break; sleep 1; done
kill \$shell 2>/dev/null; sleep 1; kill -9 \$shell 2>/dev/null || true
EOF
chmod +x "$T/inner.sh"

before=$(gsettings get org.gnome.shell enabled-extensions)
XDG_CONFIG_HOME="$T/config" XDG_DATA_HOME="$T/data" XDG_CACHE_HOME="$T/cache" \
  timeout 120 dbus-run-session -- "$T/inner.sh" > "$T/out/session.log" 2>&1 || true
if [[ $(gsettings get org.gnome.shell enabled-extensions) != "$before" ]]; then
  echo "WARNING: the real enabled-extensions changed during the test" >&2
fi

grep -h ABORT "$T/out/session.log" >&2 || true
cat "$T/out/probe.txt" "$T/out/workspaces.txt" "$T/out/cycle.txt" "$T/out/error.txt" 2>/dev/null || true
grep -E 'JS ERROR|rice-bar' "$T/out/shell.log" || true
echo "output: $T/out"
