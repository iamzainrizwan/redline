#!/usr/bin/env bash
# Pop GNOME's OSD box (the volume/brightness one) from a script:
#
#   rice-osd <icon-name> <text>      e.g. rice-osd video-display-symbolic "60 Hz"
#
# Scripts can't show it themselves (ShowOSD is shell-only on GNOME 46), so
# this writes the message to a file the rice bar watches (riceosd.js). Shows
# under Do Not Disturb, unlike notify-send. RICE_OSD_FILE overrides the path.
set -euo pipefail
(($# == 2)) || { echo "usage: rice-osd <icon-name> <text>" >&2; exit 2; }
file=${RICE_OSD_FILE:-${XDG_RUNTIME_DIR:-/run/user/$UID}/rice-osd}
# the timestamp makes a repeated message still a change
printf '%s\t%s\t%s\n' "$(date +%s%N)" "$1" "${2//$'\n'/ }" > "$file"
