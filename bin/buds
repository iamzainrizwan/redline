#!/usr/bin/env python3
"""Noise control and battery for Nothing / CMF earbuds over Bluetooth.

  buds                      mode + battery of the connected buds
  buds nc|trans|off         noise cancelling (high) / transparency / off
  buds high|mid|low|adaptive  noise cancelling strength
  buds cycle                nc -> trans -> off -> nc (like the stem gesture)
  buds ldac|aac             codec the buds offer (they reboot, ~7 s)
  buds dual on|off          dual connection (multipoint)
  buds --json [mode]        same, as JSON (the rice bar's buds card reads it)

Talks Nothing's "NT LINK" RFCOMM service (UUID aeac4a03-...), the one the
Nothing X app uses: frames are 55 60 01 <cmd le16> <len le16> <seq> <payload>
<crc16-modbus le>. Checked on the Ear (a); the CMF Buds 2a use the same
service. The channel is looked up with sdptool once per device and cached.
"""
import json, os, re, socket, subprocess, sys, time

NT_LINK = "aeac4a03-dff5-498f-843a-34487cf133eb"
MODES = {"high": 0x01, "mid": 0x02, "low": 0x03, "adaptive": 0x04,
         "off": 0x05, "trans": 0x07}
ALIASES = {"nc": "high", "anc": "high", "on": "high", "transparency": "trans"}
NAMES = {v: k for k, v in MODES.items()}
NAMES.update({0x01: "nc high", 0x02: "nc mid", 0x03: "nc low", 0x04: "nc adaptive"})
CYCLE = ["high", "trans", "off"]
GET_BATTERY, GET_ANC, SET_ANC = 0xC007, 0xC01E, 0xF00F
# codec and multipoint: from nothing-toolbox's docs/PROTOCOL.md (Headphone
# (1)); the Ear (a) answers the same reads
GET_CODEC, SET_CODEC, GET_DUAL, SET_DUAL = 0xC029, 0xF01C, 0xC027, 0xF01A
CODECS = {"aac": 0, "lhdc": 1, "ldac": 2}
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "buds")


def die(msg):
    print(f"buds: {msg}", file=sys.stderr)
    sys.exit(1)


def crc16(data):
    c = 0xFFFF
    for b in data:
        c ^= b
        for _ in range(8):
            c = (c >> 1) ^ 0xA001 if c & 1 else c >> 1
    return c


def frame(cmd, payload=b"", seq=1):
    p = bytes([0x55, 0x60, 0x01, cmd & 0xFF, cmd >> 8,
               len(payload) & 0xFF, len(payload) >> 8, seq]) + payload
    c = crc16(p)
    return p + bytes([c & 0xFF, c >> 8])


def find_buds():
    out = subprocess.run(["bluetoothctl", "devices", "Connected"],
                         capture_output=True, text=True).stdout
    for mac, name in re.findall(r"Device (\S+) (.+)", out):
        info = subprocess.run(["bluetoothctl", "info", mac],
                              capture_output=True, text=True).stdout
        if NT_LINK in info:
            return mac, name
    die("no Nothing/CMF buds connected")


def channel(mac):
    path = os.path.join(CACHE, mac.replace(":", ""))
    try:
        return int(open(path).read())
    except (OSError, ValueError):
        pass
    # sdptool can't search a 128-bit UUID; NT LINK is listed under Serial Port
    out = subprocess.run(["sdptool", "search", "--bdaddr", mac, "SP"],
                         capture_output=True, text=True, timeout=30).stdout
    m = re.search(NT_LINK + r"[^\0]*?Channel: (\d+)", out)
    if not m:
        die(f"no NT LINK service on {mac}")
    os.makedirs(CACHE, exist_ok=True)
    open(path, "w").write(m.group(1))
    return int(m.group(1))


class Link:
    def __init__(self, mac):
        self.buf, self.seq = b"", 0
        ch = channel(mac)
        for attempt in range(6):  # EBUSY while the last link is still closing
            self.s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM,
                                   socket.BTPROTO_RFCOMM)
            self.s.settimeout(3)
            try:
                self.s.connect((mac, ch))
                return
            except OSError as e:
                self.s.close()
                if attempt == 5:
                    die(f"connect {mac} ch {ch}: {e.strerror or e}")
                time.sleep(0.5)

    def frames(self):
        """Parse whole frames out of the buffer: (cmd, payload)."""
        while True:
            i = self.buf.find(b"\x55")
            if i < 0 or len(self.buf) < i + 8:
                return
            b = self.buf[i:]
            n = b[5] | b[6] << 8
            size = 8 + n + (2 if b[1] & 0x20 else 0)
            if len(b) < size:
                return
            self.buf = b[size:]
            yield b[3] | b[4] << 8, b[8:8 + n]

    def ask(self, cmd, payload=b""):
        self.seq += 1
        self.s.send(frame(cmd, payload, self.seq))
        end = time.time() + 2
        while time.time() < end:
            for rcmd, pl in self.frames():
                if rcmd & 0x3FFF == cmd & 0x3FFF:  # reply sets 0x4000, drops 0x8000
                    return pl
            self.s.settimeout(max(0.05, end - time.time()))
            try:
                self.buf += self.s.recv(1024)
            except socket.timeout:
                break
        die(f"no reply to {cmd:#06x}")

    def mode(self):
        pl = self.ask(GET_ANC)
        return pl[1] if len(pl) > 1 else None

    def set(self, name):
        self.ask(SET_ANC, bytes([0x01, MODES[name], 0x00]))

    def codec(self):
        pl = self.ask(GET_CODEC)
        return {v: k for k, v in CODECS.items()}.get(pl[0]) if pl else None

    def set_codec(self, name):
        """The buds ack, then reboot; the link may die before the ack."""
        self.seq += 1
        try:
            self.s.send(frame(SET_CODEC, bytes([CODECS[name]]), self.seq))
            self.s.settimeout(2)
            self.s.recv(1024)
        except OSError:
            pass

    def dual(self):
        pl = self.ask(GET_DUAL)
        return bool(pl[0]) if pl else None

    def set_dual(self, on):
        self.ask(SET_DUAL, bytes([1 if on else 0]))

    def battery(self):
        """[(part, percent, charging)]; a bud in the case drops out."""
        pl = self.ask(GET_BATTERY)
        parts = {0x02: "L", 0x03: "R", 0x04: "case"}
        return [(parts.get(pl[1 + 2 * k], hex(pl[1 + 2 * k])),
                 pl[2 + 2 * k] & 0x7F, bool(pl[2 + 2 * k] & 0x80))
                for k in range(pl[0] if pl else 0)]


def main():
    args = sys.argv[1:]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    want = ALIASES.get(args[0], args[0]) if args else None
    codec = dual = None
    if want in ("ldac", "aac"):
        codec, want = want, None
    elif want == "dual":
        if args[1:2] not in (["on"], ["off"]):
            die("dual on|off")
        dual, want = args[1] == "on", None
    elif want and want not in MODES and want != "cycle":
        die(f"unknown mode {args[0]} (nc trans off high mid low adaptive cycle"
            " ldac aac dual)")
    mac, name = find_buds()
    link = Link(mac)
    if codec and link.codec() != codec:
        link.set_codec(codec)
        link.s.close()
        time.sleep(4)  # still connected for a moment before the reboot
        for _ in range(30):
            out = subprocess.run(["bluetoothctl", "info", mac],
                                 capture_output=True, text=True).stdout
            if "Connected: yes" in out:
                break
            time.sleep(0.5)
        else:
            die("buds didn't come back after the codec switch")
        time.sleep(1)
        link = Link(mac)
    if dual is not None:
        link.set_dual(dual)
    if want == "cycle":
        cur = NAMES.get(link.mode(), "")
        cur = "high" if cur.startswith("nc") else cur
        want = CYCLE[(CYCLE.index(cur) + 1) % 3] if cur in CYCLE else "high"
    if want:
        link.set(want)
    m = link.mode()
    bat = link.battery()
    cod, dl = link.codec(), link.dual()
    if as_json:
        print(json.dumps({"name": name, "mac": mac,
                          "mode": {v: k for k, v in MODES.items()}.get(m, m),
                          "codec": cod, "dual": dl,
                          "battery": [{"part": p, "percent": n, "charging": c}
                                      for p, n, c in bat]}))
    else:
        print(f"{name}: {NAMES.get(m, f'mode {m:#x}')}  " + "  ".join(
            f"{p} {n}%" + ("+" if c else "") for p, n, c in bat)
            + f"  {cod or '?'}  dual {'on' if dl else 'off'}")
    link.s.close()


if __name__ == "__main__":
    main()
